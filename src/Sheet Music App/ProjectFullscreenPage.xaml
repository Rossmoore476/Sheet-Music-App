<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Sheet_Music_App.ProjectFullscreenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sheet_Music_App"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.Resources>
        <x:Double x:Key="RibbonHeight">96</x:Double>

        <!-- One tab's worth of ribbon groups, laid out left to right -->
        <Style x:Key="RibbonTabPanelStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <!-- A ribbon group: commands on top, caption along the bottom (as in Word) -->
        <Style x:Key="RibbonGroupStyle" TargetType="Grid">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Padding" Value="8,6,8,4" />
        </Style>

        <Style x:Key="RibbonGroupLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="RibbonPlaceholderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RibbonGroupSeparatorStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="0,8" />
            <Setter Property="Fill" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>

        <!-- Large ribbon command: icon above a caption, no chrome until hovered -->
        <Style x:Key="RibbonLargeButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- TextBox without the built-in clear ("x") button, which would cover most of the narrow
             zoom box. A copy of the WinUI 1.8 default TextBox template (generic.xaml) with the
             DeleteButton and its ButtonStates visual states removed; everything else is unchanged. -->
        <Style x:Key="TextBoxWithoutClearButtonStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />

                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextControlBackgroundDisabled}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextControlBorderBrushDisabled}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentElement" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextControlForegroundDisabled}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PlaceholderTextContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{Binding PlaceholderForeground, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={ThemeResource TextControlPlaceholderForegroundDisabled}}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextControlBorderBrushPointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextControlBackgroundPointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PlaceholderTextContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{Binding PlaceholderForeground, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={ThemeResource TextControlPlaceholderForegroundPointerOver}}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentElement" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextControlForegroundPointerOver}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PlaceholderTextContentPresenter" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{Binding PlaceholderForeground, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={ThemeResource TextControlPlaceholderForegroundFocused}}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextControlBackgroundFocused}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextControlBorderBrushFocused}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderElement" Storyboard.TargetProperty="BorderThickness">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextControlBorderThemeThicknessFocused}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentElement" Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource TextControlForegroundFocused}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Border x:Name="BorderElement"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Control.IsTemplateFocusTarget="True"
                                    MinWidth="{TemplateBinding MinWidth}"
                                    MinHeight="{TemplateBinding MinHeight}" />
                            <ScrollViewer x:Name="ContentElement"
                                          HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                          IsHorizontalRailEnabled="{TemplateBinding ScrollViewer.IsHorizontalRailEnabled}"
                                          IsVerticalRailEnabled="{TemplateBinding ScrollViewer.IsVerticalRailEnabled}"
                                          IsDeferredScrollingEnabled="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                                          Margin="{TemplateBinding BorderThickness}"
                                          Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsTabStop="False"
                                          AutomationProperties.AccessibilityView="Raw"
                                          ZoomMode="Disabled" />
                            <TextBlock x:Name="PlaceholderTextContentPresenter"
                                       Foreground="{Binding PlaceholderForeground, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={ThemeResource TextControlPlaceholderForeground}}"
                                       Margin="{TemplateBinding BorderThickness}"
                                       Padding="{TemplateBinding Padding}"
                                       Text="{TemplateBinding PlaceholderText}"
                                       TextAlignment="{TemplateBinding TextAlignment}"
                                       TextWrapping="{TemplateBinding TextWrapping}"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RibbonButtonCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Padding="0" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" xmlns:controls="using:Microsoft.UI.Xaml.Controls">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header background behind the tab bar and the docked ribbon, with a divider below.
             When the ribbon is in "Show tabs only" mode, row 1 is empty so this only covers the tab bar. -->
        <Border x:Name="HeaderBackground"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{ThemeResource SystemControlDisabledBaseLowBrush}"
                BorderThickness="0,0,0,1" />

        <!-- Tab bar -->
        <Grid Grid.Row="0" Padding="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left area: File button and selector bar -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12" Grid.Column="0">
                <!-- File button with dropdown -->
                <Button x:Name="FileButton" Content="File" HorizontalAlignment="Left">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Text="Save" Click="FileSaveMenuItem_Click" />
                            <MenuFlyoutItem Text="Close" Click="FileCloseMenuItem_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <!-- Selector bar for ribbon tabs -->
                <controls:SelectorBar x:Name="RibbonSelectorBar" SelectionChanged="RibbonSelector_SelectionChanged" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <controls:SelectorBarItem x:Name="DrawItem" Text="Draw" />
                    <controls:SelectorBarItem x:Name="InsertItem" Text="Insert" />
                    <controls:SelectorBarItem x:Name="ViewItem" Text="View" />
                </controls:SelectorBar>
            </StackPanel>

            <!-- Middle area: project title, right of the ribbon tabs -->
            <TextBlock x:Name="FullscreenTitle"
                       Grid.Column="1"
                       Margin="24,0,12,0"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       Text="Project" />

            <!-- Right area: Present button -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="2">
                <Button x:Name="PresentButton" Content="Present" Click="PresentButton_Click" />
            </StackPanel>
        </Grid>

        <!-- Ribbon host. Docked in row 1 ("Always show the ribbon"), or moved to row 2 and drawn
             over the top of the document while open ("Show tabs only") -->
        <Border x:Name="RibbonHost"
                Grid.Row="1"
                VerticalAlignment="Top"
                Canvas.ZIndex="1"
                Padding="12,0,12,0"
                Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{ThemeResource SystemControlDisabledBaseLowBrush}"
                BorderThickness="0">
            <!-- Word-style ribbon: a fixed-height command band made of labelled groups.
                 The height stays the same across tabs so the document doesn't jump when switching. -->
            <Border Height="{StaticResource RibbonHeight}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid>
                    <ScrollViewer HorizontalScrollMode="Auto"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled">
                        <Grid>
                            <!-- Draw tab -->
                            <StackPanel x:Name="DrawRibbon" Style="{StaticResource RibbonTabPanelStyle}" Visibility="Visible">
                                <Grid Style="{StaticResource RibbonGroupStyle}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="DRAW RIBBON PLACEHOLDER TEXT" Style="{StaticResource RibbonPlaceholderTextStyle}" />
                                    <TextBlock Grid.Row="1" Text="Draw" Style="{StaticResource RibbonGroupLabelStyle}" />
                                </Grid>
                                <Rectangle Style="{StaticResource RibbonGroupSeparatorStyle}" />
                            </StackPanel>

                            <!-- Insert tab -->
                            <StackPanel x:Name="InsertRibbon" Style="{StaticResource RibbonTabPanelStyle}" Visibility="Collapsed">
                                <Grid Style="{StaticResource RibbonGroupStyle}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="INSERT RIBBON PLACEHOLDER TEXT" Style="{StaticResource RibbonPlaceholderTextStyle}" />
                                    <TextBlock Grid.Row="1" Text="Insert" Style="{StaticResource RibbonGroupLabelStyle}" />
                                </Grid>
                                <Rectangle Style="{StaticResource RibbonGroupSeparatorStyle}" />
                            </StackPanel>

                            <!-- View tab -->
                            <StackPanel x:Name="ViewRibbon" Style="{StaticResource RibbonTabPanelStyle}" Visibility="Collapsed">
                                <!-- Zoom group -->
                                <Grid Style="{StaticResource RibbonGroupStyle}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button x:Name="ZoomOutButton"
                                                Style="{StaticResource RibbonLargeButtonStyle}"
                                                ToolTipService.ToolTip="Zoom out (Ctrl+Minus)"
                                                AutomationProperties.Name="Zoom out"
                                                Click="ZoomOutButton_Click">
                                            <StackPanel Spacing="4">
                                                <SymbolIcon Symbol="ZoomOut" />
                                                <TextBlock Text="Zoom out" Style="{StaticResource RibbonButtonCaptionStyle}" />
                                            </StackPanel>
                                        </Button>

                                        <TextBox x:Name="ZoomLevelBox"
                                                 Style="{StaticResource TextBoxWithoutClearButtonStyle}"
                                                 Text="100%"
                                                 Width="72"
                                                 Margin="4,0"
                                                 VerticalAlignment="Center"
                                                 TextAlignment="Center"
                                                 InputScope="Number"
                                                 ToolTipService.ToolTip="Zoom level (25% to 400%)"
                                                 AutomationProperties.Name="Zoom level"
                                                 KeyDown="ZoomLevelBox_KeyDown"
                                                 LostFocus="ZoomLevelBox_LostFocus" />

                                        <Button x:Name="ZoomInButton"
                                                Style="{StaticResource RibbonLargeButtonStyle}"
                                                ToolTipService.ToolTip="Zoom in (Ctrl+Plus)"
                                                AutomationProperties.Name="Zoom in"
                                                Click="ZoomInButton_Click">
                                            <StackPanel Spacing="4">
                                                <SymbolIcon Symbol="ZoomIn" />
                                                <TextBlock Text="Zoom in" Style="{StaticResource RibbonButtonCaptionStyle}" />
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="FitWidthButton"
                                                Style="{StaticResource RibbonLargeButtonStyle}"
                                                ToolTipService.ToolTip="Fit to width (Ctrl+0)"
                                                AutomationProperties.Name="Fit to width"
                                                Click="FitWidthButton_Click">
                                            <StackPanel Spacing="4">
                                                <!-- Page edges with a horizontal double arrow -->
                                                <PathIcon HorizontalAlignment="Center"
                                                          Data="M1,3 H2.5 V17 H1 Z M17.5,3 H19 V17 H17.5 Z M4,10 L8,6 V9 H12 V6 L16,10 L12,14 V11 H8 V14 Z" />
                                                <TextBlock Text="Fit width" Style="{StaticResource RibbonButtonCaptionStyle}" />
                                            </StackPanel>
                                        </Button>

                                        <Button x:Name="FitHeightButton"
                                                Style="{StaticResource RibbonLargeButtonStyle}"
                                                ToolTipService.ToolTip="Fit to height: show one whole page"
                                                AutomationProperties.Name="Fit to height"
                                                Click="FitHeightButton_Click">
                                            <StackPanel Spacing="4">
                                                <!-- Page edges with a vertical double arrow -->
                                                <PathIcon HorizontalAlignment="Center"
                                                          Data="M3,1 V2.5 H17 V1 Z M3,17.5 V19 H17 V17.5 Z M10,4 L6,8 H9 V12 H6 L10,16 L14,12 H11 V8 H14 Z" />
                                                <TextBlock Text="Fit height" Style="{StaticResource RibbonButtonCaptionStyle}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Text="Zoom" Style="{StaticResource RibbonGroupLabelStyle}" />
                                </Grid>
                                <Rectangle Style="{StaticResource RibbonGroupSeparatorStyle}" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Ribbon display options (the "v" in the bottom-right corner, as in Word) -->
                    <Button x:Name="RibbonDisplayOptionsButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,4,4"
                            Padding="6,4"
                            Background="{ThemeResource SubtleFillColorTransparentBrush}"
                            BorderBrush="Transparent"
                            ToolTipService.ToolTip="Ribbon display options"
                            AutomationProperties.Name="Ribbon display options">
                        <FontIcon Glyph="&#xE70D;" FontSize="12" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <RadioMenuFlyoutItem x:Name="AlwaysShowRibbonItem"
                                                     Text="Always show the ribbon"
                                                     GroupName="RibbonDisplayMode"
                                                     IsChecked="True"
                                                     Click="AlwaysShowRibbonItem_Click" />
                                <RadioMenuFlyoutItem x:Name="ShowTabsOnlyItem"
                                                     Text="Show tabs only"
                                                     GroupName="RibbonDisplayMode"
                                                     Click="ShowTabsOnlyItem_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>
        </Border>

        <!-- Project content area: scrollable, zoomable concatenated PDF pages, directly below the ribbon.
             Built-in ScrollViewer zoom gives pinch-to-zoom, Ctrl+mouse wheel and touchpad gestures for free. -->
        <ScrollViewer x:Name="PdfScrollViewer"
                      Grid.Row="2"
                      ZoomMode="Enabled"
                      MinZoomFactor="0.25"
                      MaxZoomFactor="4"
                      HorizontalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto"
                      VerticalScrollBarVisibility="Auto"
                      IsTabStop="True"
                      ViewChanged="PdfScrollViewer_ViewChanged"
                      SizeChanged="PdfScrollViewer_SizeChanged">
            <StackPanel x:Name="PdfPagesPanel"
                        Orientation="Vertical"
                        HorizontalAlignment="Center"
                        Padding="24,0,24,24"
                        Spacing="12" />
        </ScrollViewer>

        <ProgressRing x:Name="LoadingRing"
                      Grid.Row="2"
                      IsActive="False"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
    </Grid>
</Page>
