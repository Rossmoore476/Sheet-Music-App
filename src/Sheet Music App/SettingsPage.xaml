<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Sheet_Music_App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sheet_Music_App"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <Grid x:Name="LayoutRoot" Padding="36">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="RightColumnDef" 
                              Width="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Visual states: default layout stacks right column below; Wide places it to the right -->
        <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="AdaptiveStates">
                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <!-- Move right column content below; remove second column by setting width to 0 and span main across both columns -->
                            <Setter Target="RightColumnHolder.(Grid.Row)" Value="1" />
                            <Setter Target="RightColumnHolder.(Grid.Column)" Value="0" />
                            <Setter Target="RightColumnDef.Width" Value="0" />
                            <Setter Target="MainStack.(Grid.ColumnSpan)" Value="2" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="700" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="RightColumnHolder.(Grid.Row)" Value="0" />
                            <Setter Target="RightColumnHolder.(Grid.Column)" Value="1" />
                            <Setter Target="RightColumnDef.Width" Value="320" />
                            <Setter Target="MainStack.(Grid.ColumnSpan)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Main column content -->
        <StackPanel x:Name="MainStack" Grid.Row="0" Grid.Column="0" Spacing="4" HorizontalAlignment="Stretch">
            <TextBlock Text="Settings" FontSize="40" FontWeight="SemiBold" />
			<Border Height="12" />
            <TextBlock Text="Appearance" FontSize="14" FontWeight="SemiBold" />
			<Border Height="2" />
            <!-- App theme settings card (moved functionality from expander) -->
            <toolkit:SettingsCard Header="App theme" Description="Select which app theme to display">
				<toolkit:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE790;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ThemeCombo" SelectionChanged="ThemeCombo_SelectionChanged">
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                    <ComboBoxItem Content="Use system setting" />
                </ComboBox>
            </toolkit:SettingsCard>

			<toolkit:SettingsCard Header="Navigation">
				<toolkit:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE90C;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="NavStyleCombo" SelectionChanged="NavStyleCombo_SelectionChanged">
                    <ComboBoxItem Content="Left" />
                    <ComboBoxItem Content="Top" />
                </ComboBox>
            </toolkit:SettingsCard>

			<toolkit:SettingsExpander Description="Select where to save files" Header="Save location">
				<toolkit:SettingsExpander.HeaderIcon>
					<FontIcon Glyph="&#xE74E;" />
				</toolkit:SettingsExpander.HeaderIcon>
				<toolkit:SettingsExpander.Items>
					<toolkit:SettingsCard>
						<toolkit:SettingsCard.Description>
							<Border Height="16" />
						</toolkit:SettingsCard.Description>
					</toolkit:SettingsCard>
				</toolkit:SettingsExpander.Items>
			</toolkit:SettingsExpander>

        
	
	</StackPanel>

        <!-- Right column: About / links -->
        <StackPanel x:Name="RightColumnHolder" Grid.Row="1" Grid.Column="0" Margin="24,0,0,0" Spacing="4">
            <TextBlock Text="About Sheet Music App" FontWeight="SemiBold" />
			<Border Height="2" />
            <TextBlock TextWrapping="Wrap" Foreground="#BBBBBB" FontSize="12" xml:space="preserve">Sheet Music App 1.0.0 </TextBlock>
			<TextBlock TextWrapping="Wrap" Foreground="#BBBBBB" FontSize="12" xml:space="preserve">© 2026 Ross Moore. All rights reserved.</TextBlock>

            
            <HyperlinkButton Content="License Terms" Click="Link_Licence"/>
            <HyperlinkButton Content="GitHub Repository" Click="Link_GitHub"/>
            <HyperlinkButton Content="Send feedback" Click="Link_Feedback"/>
        </StackPanel>
    </Grid>
</Page>
