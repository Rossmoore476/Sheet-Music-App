<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Sheet_Music_App.NewProjectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sheet_Music_App">

    <Grid Padding="24">
        <StackPanel Spacing="12">
            <TextBlock Text="New Project" FontSize="24" FontWeight="SemiBold" />

            <StackPanel Orientation="Vertical" Spacing="8">
                <TextBlock Text="Project Name" />
                <TextBox x:Name="ProjectNameTextBox" PlaceholderText="Enter project name" />

                <TextBlock Text="Description" />
                <TextBox x:Name="ProjectDescriptionTextBox" AcceptsReturn="True" Height="80" TextWrapping="Wrap" PlaceholderText="Optional description" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
                <Button x:Name="AddPieceButton" Content="Add Piece" />
                <Button x:Name="SaveProjectButton" Content="Save Project" />
            </StackPanel>

            <TextBlock Text="Pieces" FontWeight="SemiBold" Margin="0,8,0,0" />

            <ListView x:Name="PiecesListView" CanDragItems="True" CanReorderItems="True" ReorderMode="Enabled" AllowDrop="True" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:PieceViewModel">
                        <Grid Margin="0,4" ColumnDefinitions="2*,2*,Auto,Auto" VerticalAlignment="Center">
                            <TextBox Text="{Binding Title, Mode=TwoWay}" PlaceholderText="Piece Title" Margin="4" />
                            <TextBox Grid.Column="1" Text="{Binding Composer, Mode=TwoWay}" PlaceholderText="Composer" Margin="4" />
                            <Button Grid.Column="2" Content="Choose PDF" Margin="4" Click="OnChoosePdfClicked" />
                            <Button Grid.Column="3" Content="Remove" Margin="4" Click="OnRemovePieceClicked" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </Grid>
</Page>
